# Snap2Know MBP Backend Environment Variables
# Copy this file to .env and fill in the values

# OpenAI API Key (for STT, Embedding, optional TTS)
OPENAI_API_KEY=sk-xxx
# 可选：自定义 OpenAI API 地址（如使用代理服务）
OPENAI_BASE_URL=

# Anthropic API Key (for OCR, LLM)
ANTHROPIC_API_KEY=sk-ant-xxx
# 可选：自定义 Anthropic API 地址
ANTHROPIC_BASE_URL=

# 代理配置（如需要）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333

# TTS Mode: auto, edge, local, cloud
TTS_MODE=auto

# Debug Mode
DEBUG=false
