# Snap2Know MBP Backend Environment Variables
# Copy this file to .env and fill in the values

# OpenAI API Key (for STT, Embedding, optional TTS)
OPENAI_API_KEY=sk-xxx

# Anthropic API Key (for OCR, LLM)
ANTHROPIC_API_KEY=sk-ant-xxx

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333

# TTS Mode: auto, edge, local, cloud
TTS_MODE=auto

# Debug Mode
DEBUG=false
